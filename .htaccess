Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Keep CMS/admin routes untouched.
  RewriteRule ^(admin|cms)(/|$) - [L]

  # Redirect direct .html requests to clean URLs (works on root or subfolder).
  RewriteCond %{THE_REQUEST} \s/+[^\s?]+\.html(?:[\s?]|$) [NC]
  RewriteRule ^(.+)\.html$ $1 [R=301,L,NE]

  # Serve existing files/folders as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Map extensionless routes to existing .html files.
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
